[snr, signal_power, noise_power, total_loss] = link([10:5:90,10:5:90],[170e3*ones(1,length(10:5:90)),420e3*ones(1,length(10:5:90))],10e3) %[output:60003a65] %[output:499f1aee] %[output:883cda3d] %[output:3de91792]
radar_rx_power_max = 10*log10(5e6) - total_loss %[output:606c7ab8]
radar_rx_power_min = 10*log10(1e6) - total_loss %[output:0b2a331c]
figure %[output:49330e32]
hold on %[output:49330e32]
plot(10:5:90,signal_power(1:17),"DisplayName","Alt=170km") %[output:49330e32]
plot(10:5:90,signal_power(18:end),"DisplayName","Alt=420km") %[output:49330e32]
plot(10:5:90,noise_power*ones(length(10:5:90),1),"DisplayName","Noise") %[output:49330e32]

title("Received Signal Power @ 10kHz BW By Altitude") %[output:49330e32]
xlabel("Elevation (Degrees)") %[output:49330e32]
ylabel("P (dBW)") %[output:49330e32]
legend %[output:49330e32]

figure %[output:32a650dc]
hold on %[output:32a650dc]
plot(10:5:90,signal_power(1:17),      "DisplayName","Alt=170km") %[output:32a650dc]
plot(10:5:90,radar_rx_power_max(1:17),"DisplayName","Fylingdales Max"); %[output:32a650dc]
plot(10:5:90,radar_rx_power_min(1:17),"DisplayName","Fylingdales Min"); %[output:32a650dc]

plot(10:5:90,noise_power*ones(length(10:5:90),1),"DisplayName","Noise") %[output:32a650dc]

title("Received Signal Power @ 10kHz BW By Altitude") %[output:32a650dc]
xlabel("Elevation (Degrees)") %[output:32a650dc]
ylabel("P (dBW)") %[output:32a650dc]
legend %[output:32a650dc]
figure %[output:45d9e0a4]
hold on %[output:45d9e0a4]
plot(10:5:90,signal_power(1:17)       - noise_power,"DisplayName","Alt=170km") %[output:45d9e0a4]
plot(10:5:90,radar_rx_power_max(1:17) - noise_power,"DisplayName","Fylingdales Max"); %[output:45d9e0a4]
plot(10:5:90,radar_rx_power_min(1:17) - noise_power,"DisplayName","Fylingdales Min"); %[output:45d9e0a4]


title("Received SNR @ 10kHz BW By Altitude") %[output:45d9e0a4]
xlabel("Elevation (Degrees)") %[output:45d9e0a4]
ylabel("SNR (dB)") %[output:45d9e0a4]
legend %[output:45d9e0a4]
%[text] Doppler Shift
sat_doppler_420 = dopplerShiftCircularOrbit(10:5:180,420e3,38,437e6);
sat_doppler_170 = dopplerShiftCircularOrbit(10:5:180,170e3,38,437e6);

figure %[output:19c7e780]
hold on %[output:19c7e780]
plot(10:5:180,sat_doppler_420/1e3, "DisplayName","420km") %[output:19c7e780]
plot(10:5:180,sat_doppler_170/1e3, "DisplayName","170km") %[output:19c7e780]
legend %[output:19c7e780]
ylabel("Doppler Shift (kHz)") %[output:19c7e780]
xlabel("Elevation Angle (Degrees)") %[output:19c7e780]
%[text] SIR elevation to STAC and elevation to Fylingdales
elevs = 0:5:90;
f = 437e6;
altsat = 170e3;
bw = 10e3;
rad_power = 10*log10(5e6);

[el_sat,el_rad] = meshgrid(10:5:90);
sir = zeros(size(el_sat));

for el_sat_it = 1:length(el_sat)
    for el_rad_it = 1:length(el_rad)
        sat_snr = link(el_sat_it,altsat,bw);
        [~, ~, ~, rad_loss] = link(el_rad_it,altsat,bw);
        sir(el_sat_it,el_rad_it) = sat_snr - (rad_power - rad_loss - noise_power);
    end
end

figure %[output:4f3b4000]
contour(el_sat,el_rad,sir) %[output:4f3b4000]
xlabel("Elevation to Ground Station") %[output:4f3b4000]
ylabel("Elevation to RADAR") %[output:4f3b4000]
xticks([elevs]) %[output:4f3b4000]
yticks([elevs]) %[output:4f3b4000]
colorbar %[output:4f3b4000]
%%
% gaussedesign for GMSK

fs = 20e6 %[output:4ab48ca7]
fc = 2.5e6;

x_binary = round(rand(1000000,1))*2-1;

h = [-0.009253104890029	-0.000799828563126	-0.000715370565626	-0.000542821963991	-0.000272221967837	0.000100510747012	0.000582157003943	0.001173921665491	0.001887621442992	0.002717519974823	0.003668545166740	0.004739578808443	0.005927892239336	0.007228411212460	0.008635118928037	0.010139656955200	0.011731692525792	0.013397489160392	0.015125120437740	0.016896883777672	0.018697065567220	0.020505900079691	0.022306040450011	0.024076931728017	0.025798774281452	0.027451542290956	0.029018787879000	0.030476583272590	0.031812864801518	0.033004205971757	0.034046889760470	0.034907055888895	0.035593091347607	0.036097000119748	0.036391696260664	0.036493428553847	0.036391696260664	0.036097000119748	0.035593091347607	0.034907055888895	0.034046889760470	0.033004205971757	0.031812864801518	0.030476583272590	0.029018787879000	0.027451542290956	0.025798774281452	0.024076931728017	0.022306040450011	0.020505900079691	0.018697065567220	0.016896883777672	0.015125120437740	0.013397489160392	0.011731692525792	0.010139656955200	0.008635118928037	0.007228411212460	0.005927892239336	0.004739578808443	0.003668545166740	0.002717519974823	0.001887621442992	0.001173921665491	0.000582157003943	0.000100510747012	-0.000272221967837	-0.000542821963991	-0.000715370565626	-0.000799828563126	-0.009253104890029] %[output:893d2573]
x_audio=  filter(h,1,10*load('gong').y);


doubleY = ammod(x_audio,fc,fs);

sadsb = spectrumAnalyzer( ... %[output:group:6db7e3d7] %[output:580ab0a7] %[output:521f1f6f]
    SampleRate=fs, ... %[output:580ab0a7] %[output:521f1f6f]
    PlotAsTwoSidedSpectrum=false) %[output:group:6db7e3d7] %[output:580ab0a7] %[output:521f1f6f]
sadsb(doubleY) %[output:521f1f6f]


