%[text] # SALSAT Data Visualisation
%[text:tableOfContents]{"heading":"Table of Contents"}
%[text] ## PSD Measurement Table
%[text] Importing the data retreived from SALSAT website.
function [table, psd, freqs] = read_salsat_tab(path)
    table = readtable(path);
    table = renamevars( ...
                    table, ...
                    table.Properties.VariableNames, ...
                    ["id",	"Date",	"Lat",	"Lon",	"Band",	"Center Freq [MHz]",	"Bandwidth [MHz]",	"Median",	"Integration Time",	"PSD"] ...
                    );
    psd = str2double(split(table(:,"PSD").Variables,","));

    freqs = linspace( ...
                table(1,:).("Center Freq [MHz]")-table(1,:).("Bandwidth [MHz]")/2, ...
                table(1,:).("Center Freq [MHz]")+table(1,:).("Bandwidth [MHz]")/2, ...
                width(psd) ...
                );

end
[salsat_tab,salsat_psd, salsat_freqs] = read_salsat_tab(fileparts(matlab.desktop.editor.getActiveFilename)+"/salsat_raw/fft_data_2023-04-19 12_29_29 - 2023-04-19 12_30_04.csv");




%%
date_choice = 5; %[control:slider:8429]{"position":[15,16]}
fig = figure();  %[output:7f09ffd2]
fig.Position(3:4) = [1000, 500]; %[output:7f09ffd2]
hold on %[output:7f09ffd2]
title("PSD at "+string(salsat_tab(date_choice,:).Date)) %[output:7f09ffd2]
plot(salsat_freqs,salsat_psd(date_choice,:)) %[output:7f09ffd2]
xlabel("Frequency (MHz)") %[output:7f09ffd2]
ylim([-100,0]) %[output:7f09ffd2]
ylabel("RSSI (dB)") %[output:7f09ffd2]
hold off %[output:7f09ffd2]
%%
%[text] Zooming on the area of major interference:
fig = figure();  %[output:6fae22ea]
fig.Position(3:4) = [1000, 1000]'; %[output:6fae22ea]
hold on %[output:6fae22ea]

subplot(2,1,1) %[output:6fae22ea]
plot(salsat_freqs,salsat_psd(4,:)) %[output:6fae22ea]
title("PSD at "+string(salsat_tab(4,:).Date)) %[output:6fae22ea]
xlabel("Frequency (MHz)") %[output:6fae22ea]
ylabel("RSSI (dB)") %[output:6fae22ea]
xlim([434,436.5]) %[output:6fae22ea]


subplot(2,1,2) %[output:6fae22ea]
plot(salsat_freqs,salsat_psd(2,:)) %[output:6fae22ea]
title("PSD at "+string(salsat_tab(2,:).Date)) %[output:6fae22ea]
xlabel("Frequency (MHz)") %[output:6fae22ea]
ylabel("RSSI (dB)") %[output:6fae22ea]
xlim([434,436.5]) %[output:6fae22ea]
xticks([434:0.1:436.5]) %[output:6fae22ea]
grid minor %[output:6fae22ea]
hold off %[output:6fae22ea]
%%
%[text] ## Looking at other SALSAT readings, and showing orbital position
Location = "over_uk"; %[control:dropdown:84a4]{"position":[12,21]}
path = fileparts(matlab.desktop.editor.getActiveFilename)+"/salsat_raw/"+Location+"/";
file_list = dir(path+"*.csv");
file_list = string({file_list.name});
file = file_list(1); % Sometimes throws error if index chosen higher than available in different location %[control:dropdown:7182]{"position":[8,20]}

[table, psd, freqs] = read_salsat_tab(path+file);
salsat_alt = 530e3; 


fig = figure();  %[output:1eb6bcc9]
fig.Position(3:4) = [500, 500]; %[output:1eb6bcc9]
hold on %[output:1eb6bcc9]
% Remove cart axes
set(gca,'XColor', 'none','YColor','none') %[output:1eb6bcc9]
set(gca, 'color', 'none'); %[output:1eb6bcc9]

gx1 = geoaxes; %[output:1eb6bcc9]
geoplot(table.Lat, table.Lon,"o-",table(1,:).Lat, table(1,:).Lon,"o-red",'LineWidth',5,"DisplayName","SALSAT Path") %[output:1eb6bcc9]
% hold on
% 
% % JWGS area
% r = slantRangeCircularOrbit(40,417e3,38);
% [latr,lonr] = scircle1(55.86246389842071,-4.246009308343842,km2deg(r));
% geoplot(latr,wrapTo360(lonr),'LineWidth',3)

latlim = [20 65];
lonlim = [-25 15];
geolimits(gx1,latlim,lonlim) %[output:1eb6bcc9]


hold off %[output:1eb6bcc9]

fig = figure();  %[output:49190160]
fig.Position(3:4) = [2000, 500]; %[output:49190160]
hold on %[output:49190160]

subplot(1,2,1) %[output:49190160]
[X,Y] = meshgrid(freqs,datenum(table.Date));
C = gradient(psd);
waterfall(X,Y,psd,C) %[output:49190160]
yt=yticks; yticks(yt(1:2:end))  % not going to be room for very many tick labels so cut 'em down... %[output:49190160]
datetick('y','hh:mm:ss','keepticks','keeplimits') %[output:49190160]
colorbar %[output:49190160]
view([349 77]) %[output:49190160]

subplot(1,2,2) %[output:49190160]
imagesc(freqs,table.Date,psd) %[output:49190160]
zlim([-inf +inf]) %[output:49190160]
colorbar %[output:49190160]

hold off %[output:49190160]
freq_slice = [431 433]; %[control:rangeslider:5deb]{"position":[14,23]}

for i = 1:length(table.Date) %[output:group:28527412]
    fig = figure();  %[output:9db60847] %[output:0c9e3517] %[output:9a7e1c5d] %[output:85326baf] %[output:08c5b85b] %[output:747d46a4] %[output:1c961b46] %[output:3cb7ffff] %[output:12a15183] %[output:4bfed28d] %[output:09b6ffd8] %[output:0fdc1c1d] %[output:0ec06b03] %[output:7c87e0c4] %[output:299334ec] %[output:33cc2491] %[output:52965967] %[output:7ba76062] %[output:422ca8b7] %[output:153c3d84] %[output:6824cdaa] %[output:3fa014a2] %[output:66d29b10] %[output:0bc5893f] %[output:4c2565aa] %[output:9cf5e152] %[output:1b983ef3] %[output:7c9bf4d9] %[output:24207e01] %[output:5a675ed6] %[output:8a54362f]
    fig.Position(3:4) = [1000,250]; %[output:9db60847] %[output:0c9e3517] %[output:9a7e1c5d] %[output:85326baf] %[output:08c5b85b] %[output:747d46a4] %[output:1c961b46] %[output:3cb7ffff] %[output:12a15183] %[output:4bfed28d] %[output:09b6ffd8] %[output:0fdc1c1d] %[output:0ec06b03] %[output:7c87e0c4] %[output:299334ec] %[output:33cc2491] %[output:52965967] %[output:7ba76062] %[output:422ca8b7] %[output:153c3d84] %[output:6824cdaa] %[output:3fa014a2] %[output:66d29b10] %[output:0bc5893f] %[output:4c2565aa] %[output:9cf5e152] %[output:1b983ef3] %[output:7c9bf4d9] %[output:24207e01] %[output:5a675ed6] %[output:8a54362f]
    plot(freqs,psd(i,:))
    title(string(table(i,:).Date))
    xlim(freq_slice)
end %[output:group:28527412]

%[appendix]{"version":"1.0"}
