%[text] # Peak Search in FRFT Domain
%[text:tableOfContents]{"heading":"Table of Contents"}
%[text] ## Input Signal
% Signal
fs = 2000;
T = 0.25;
t = 0: 1/fs : T - 1/fs;
B = 500;
k = B/(2*T);
f0 = 0;

s = chirp(t(1: fs*T),f0,k);


figure %[output:66937bde]
hold on %[output:66937bde]
plot(t,real(s)) %[output:66937bde]
title("Input Signal") %[output:66937bde]
hold off %[output:66937bde]
%[text] Let's have a look at it in frft domain:
p = 0: 1 / 400 : 2;

s_frft = zeros(length(p),length(s));

for i = 1:length(p)
    s_frft(i,:) = frft(s,p(i));
end

s_frft_sqmag = abs(s_frft).^2;

fig = figure();  %[output:14f3f403]
fig.Position(3:4) = [1000, 500]; %[output:14f3f403]

subplot(2,1,1) %[output:14f3f403]
frft_plot = imagesc(p,0:length(s)-1,10*log10(s_frft_sqmag)); %[output:14f3f403]
xlabel('p') %[output:14f3f403]
ylabel(" u ") %[output:14f3f403]
zlabel("|X_\alpha (u)|^2") %[output:14f3f403]
colormap(gca,hot), colorbar %[output:14f3f403]
%Place datatip at peak value
[frft_maxval,frft_maxidx] = max(s_frft,[],"all");
frft_maxtip = datatip(frft_plot,'DataIndex',frft_maxidx,'Location','southwest'); %[output:14f3f403]
frft_plot.DataTipTemplate.DataTipRows(end+1) = dataTipTextRow("Magnitude",s_frft_sqmag); %[output:14f3f403]

subplot(2,1,2) %[output:14f3f403]
plot(p,max(10*log10(s_frft_sqmag'))) %[output:14f3f403]
ylabel("max(|X_\alpha (u)|^2)") %[output:14f3f403]

hold on; %[output:14f3f403]
p_opt = p(mod(frft_maxidx,length(p))) %[output:527d2edb]
xline(p_opt, 'r--', 'LineWidth', 1.5); %[output:14f3f403]
hold off; %[output:14f3f403]
%%
%[text] ## Algorithm
%[text] Basic Gradient ascent
%[text] For each iteration:
%[text] 1. Calculate FRFT
%[text] 2. Find max(frft(alpha)) \
function peakval = get_frft_pk(sig,p)
    peakval = max(frft(sig,p))
end
%[text] Next iteration:
%[text] 1. Is current \> best? Y -\> current = best \
%[text]  
p_bounds = [0 2]; %[control:rangeslider:0a7a]{"position":[12,17]}

p_step     = 0.1;
p_best     = 1.5;
p_next     = 0;
p_current  = p_bounds(2);% + (p_bounds(2) - p_bounds(1))/2 ;
best_val   = 0;
frft_current = zeros(1,length(s));
max_window = zeros(1,5);

mfactor = 1*p_step;
momentum = -1*mfactor;

grad_window = max_window;
grad_exponent = 5*10^-1;
grad_prev = 0;
grad_current = 0;

cumsum = 0;


max_steps = 100; %[control:editfield:37eb]{"position":[13,16]}

% DEBUG
p_current_vals = zeros(1,max_steps);
momentum_vals  = zeros(1,max_steps);
p_best_vals    = zeros(1,max_steps);
p_step_vals    = zeros(1,max_steps);

devvals = zeros(1,max_steps);

for n = 1:max_steps %[output:group:2541db5a]
    frft_current = frft(s,p_current)';
    curmax = max(abs(frft_current).^2);
    if curmax > best_val
        best_val = frft_current_max;
        p_best = p_current;
    else

    end
    
    % Update window --------------------------------
    % Moving left
    if momentum < 0
        max_window(1) = curmax;
        fprintf("moving left\n") %[output:519cc9c7] %[output:4d9f082b] %[output:825cfd3f] %[output:485d7ada] %[output:15e71f34] %[output:0878462e] %[output:93705adc] %[output:6684fb36] %[output:70375ffd] %[output:11eb2964] %[output:819dff46] %[output:2204639e] %[output:94800a56] %[output:7d0b4168] %[output:5fb98c4b] %[output:35269418] %[output:7db4f421] %[output:33856f9c] %[output:647de600] %[output:7c87d457] %[output:5d0556c0] %[output:99271d44] %[output:7ca93288] %[output:164810f9] %[output:94a50f62] %[output:9a53489e] %[output:6e134553] %[output:680d3719] %[output:4331e978] %[output:5dc422c9] %[output:8d5d4d84] %[output:28dfc49d] %[output:6e6359a2] %[output:368aeef0] %[output:7a1d0fd0] %[output:11556e87] %[output:37be6616] %[output:29bbe206] %[output:37f9d44d] %[output:5099965d] %[output:381cd761] %[output:6d308555] %[output:42dfcb5f] %[output:562f47b6] %[output:2b05730c] %[output:583287e5] %[output:4af1391d] %[output:86dfc760] %[output:6708c5e1] %[output:741e7335] %[output:2ac00a4d] %[output:6b5776a8] %[output:07a4cc89] %[output:11147354] %[output:0e8a5a05] %[output:73bebeaa] %[output:9efb237a] %[output:54a6d545] %[output:7b62c61e] %[output:2f70700a] %[output:98356317] %[output:54a8b1ca] %[output:35b9a9d2] %[output:32282163] %[output:0a2b6dc5] %[output:6075f710] %[output:426a3ce9] %[output:5fbc413a] %[output:4ae1b32a] %[output:986730fa] %[output:94b11658] %[output:1d11fd42] %[output:91f5d84e] %[output:7c9ba95f] %[output:83ebc149] %[output:995c36fb] %[output:8fb4b0f5] %[output:6dea6ba2] %[output:607322ee] %[output:4136061f] %[output:37244e18] %[output:20f9a3fd] %[output:6641656b] %[output:53ff74e8] %[output:180809a0] %[output:94753de0] %[output:9355f5b2] %[output:31448973] %[output:5444284b] %[output:3ecce4f1] %[output:02ddf1de] %[output:1cd1225e] %[output:53624bb6] %[output:6aff6ddb] %[output:5e2f3014] %[output:7de2c9cd] %[output:3e3ab588] %[output:0e66f1e2] %[output:5685c1c7] %[output:1cd2e269]

    % Moving Right
    elseif momentum > 0
        max_window(3) = curmax;
    % Stationary; TODO:
        fprintf("moving right\n")
    elseif momentum == 0
        fprintf("momentum 0\n")
    end
    
    % DEBUG:
    fprintf("window: [%.2f,%.2f,%.2f] ",max_window(1),max_window(2),max_window(3)) %[output:3db813da] %[output:79f1be04] %[output:1c7d1073] %[output:1f9de6f2] %[output:9531e33e] %[output:431e22dd] %[output:55d504af] %[output:02cc511d] %[output:32c1b246] %[output:92f46029] %[output:2ea72ca6] %[output:5d5ed14d] %[output:84a9cf47] %[output:927f2ff1] %[output:3f24ab2a] %[output:879f2ef3] %[output:058b5343] %[output:76213b34] %[output:42ed7333] %[output:192b0385] %[output:06ba4c47] %[output:2315f735] %[output:688fc731] %[output:55341726] %[output:6ea6e0a0] %[output:71806aeb] %[output:3d858f76] %[output:11f6510f] %[output:2facd7b4] %[output:0ff5671a] %[output:297c6cd6] %[output:63283189] %[output:632162dc] %[output:9f78aa43] %[output:294cc28c] %[output:10ec14a6] %[output:73662e12] %[output:86eac727] %[output:010cd7b5] %[output:0f1e9650] %[output:44725a29] %[output:6a63528d] %[output:23326ee1] %[output:1b15dd50] %[output:1f9119f4] %[output:14cc3473] %[output:1b65becc] %[output:9dcb4466] %[output:5b6a6d20] %[output:83d9b389] %[output:2ffdbc7e] %[output:905b2d09] %[output:746425b3] %[output:566485d0] %[output:23500a73] %[output:3f552bab] %[output:827ea31f] %[output:137062b4] %[output:9c97677c] %[output:46a79cf7] %[output:18238642] %[output:63ddff85] %[output:4f6b6d7a] %[output:88854365] %[output:0125cc8f] %[output:06f2a43c] %[output:84efa9c1] %[output:3cc054bd] %[output:58972d3b] %[output:57fb4751] %[output:5639763a] %[output:6ba40c94] %[output:7a93c34f] %[output:0c673ffe] %[output:1a3fdfa4] %[output:648fb585] %[output:81bbd250] %[output:7efc263f] %[output:7f5370ee] %[output:00b566b2] %[output:6b481010] %[output:980666cf] %[output:345597bb] %[output:44e71fec] %[output:9e1a65cf] %[output:8f75be7e] %[output:3b5a97e3] %[output:6c8f40b8] %[output:631e6a1a] %[output:4f1e4df8] %[output:3dcab796] %[output:1f4dfeff] %[output:6ba0e1f1] %[output:91791b21] %[output:9c4c0658] %[output:273d847d] %[output:9f6bafc7] %[output:4c4f9fb2] %[output:86cac94e] %[output:3e767789]

%[output:6a14e6e5] %[output:582b65ca] %[output:802d663f] %[output:9db9e3d9] %[output:3afae3c2] %[output:0ce3ba33] %[output:88c3a891] %[output:82ccaf77] %[output:569d660c] %[output:2c37cb71] %[output:530496dc] %[output:2222a998] %[output:155b06d3] %[output:8c916d48] %[output:8a0f2298] %[output:796b4fc7] %[output:3a43d448] %[output:68733e93] %[output:7eb9d3d1] %[output:5a0da096] %[output:2276dd43] %[output:07054640] %[output:1d82bcf5] %[output:4c1fb03b] %[output:2f186e2e] %[output:803d93f1] %[output:98f8893b] %[output:0f403dfc] %[output:6dc778f8] %[output:69d804ff] %[output:086d1189] %[output:4c6fb990] %[output:0717d86b] %[output:63780345] %[output:0ed1555c] %[output:93d90f9f] %[output:0f25d6f0] %[output:6ab7e3f4] %[output:67846bc0] %[output:08710b56] %[output:3f8823c5] %[output:95ee9639] %[output:22b77c1f] %[output:725ddbee] %[output:9c4ab5fc] %[output:66b18c35] %[output:9b3128df] %[output:8eee9300] %[output:5c59179c] %[output:401ecd79] %[output:43ec86cd] %[output:6d205fdd] %[output:94ce99ce] %[output:6efb6182] %[output:242e35c9] %[output:0ca50973] %[output:9fda7e00] %[output:60ccf3c6] %[output:4cf93adc] %[output:0734ca99] %[output:44eb0e43] %[output:1eb9418e] %[output:1de7b9b3] %[output:993a399a] %[output:443ad823] %[output:875412be] %[output:6a0c2769] %[output:6035d693] %[output:94e64343] %[output:9c591e11] %[output:3de2724f] %[output:8cd0f616] %[output:7704a0d0] %[output:60ac02a9] %[output:8c95a15c] %[output:019c18ad] %[output:40b1a050] %[output:28c82997] %[output:8bddf91a] %[output:473d8579] %[output:69ccfcd1] %[output:667b93fb] %[output:2cc0f2d8] %[output:3112c758] %[output:0478d857] %[output:132d4e2e] %[output:8a1bb56e] %[output:3332c433] %[output:67da07c0] %[output:62d0b9f2] %[output:9135d279] %[output:529899d1] %[output:8ddbf620] %[output:6c6f7756] %[output:3ddf5d22] %[output:12fbd82d] %[output:8980ab3c] %[output:253331bb] %[output:0e338d54] %[output:4598cbd5]
    
    if n > length(max_window)
        g = gradient(max_window,p_step);
        
        cumsum = cumsum + sum(max_window);
        av = cumsum/n;
        sdev = sqrt(sum( (max_window - av).^2 ) /n) %[output:677dcb95] %[output:38a6f1b5] %[output:49ec0f15] %[output:959b923c] %[output:7cba3fbb] %[output:464b4d9f] %[output:25670c83] %[output:9e4ead26] %[output:8a67bed8] %[output:29831fad] %[output:5b807d4b] %[output:726b705c] %[output:195b1660] %[output:57b94e6f] %[output:9de714d8] %[output:42f66254] %[output:91d3b018] %[output:4e856c5d] %[output:103d66fb] %[output:4b3a7023] %[output:4cde2428] %[output:05a4b0cd] %[output:469ac21c] %[output:40162db8] %[output:0e3590ff] %[output:4446fe45] %[output:355af5a0] %[output:5034fa0b] %[output:9323048a] %[output:60c5f7e4] %[output:08898124] %[output:4c8254bf] %[output:1550606c] %[output:6a1d8767] %[output:9bbee247] %[output:9ec2ccd7] %[output:184e491d] %[output:7993aacf] %[output:6e1b10cf] %[output:18d04964] %[output:84919149] %[output:5808bfb9] %[output:95a43aed] %[output:66a62ff0] %[output:3dc5a844] %[output:0fb3ee83] %[output:990c34dc] %[output:17a73bd1] %[output:1a7ebb5b] %[output:45d5fb7b] %[output:1043471e] %[output:4af2c197] %[output:04f80a5f] %[output:9014bcef] %[output:87699615] %[output:3d3060e2] %[output:1773fe20] %[output:53de3fb2] %[output:90d28954] %[output:8575e185] %[output:0439dac8] %[output:9155dde1] %[output:2f446ba0] %[output:9ec450d1] %[output:60d388b1] %[output:85efe098] %[output:47bb0957] %[output:01c754c1] %[output:33bbc961] %[output:4f10d98d] %[output:06913615] %[output:322f29fa] %[output:4cdfefff] %[output:9eaf486a] %[output:11500654] %[output:5f3f1789] %[output:0fac8878] %[output:07b2b884] %[output:34f323f1] %[output:8b2ddaa6] %[output:9cdb1b85] %[output:40645669] %[output:94538c27] %[output:44114525] %[output:4eeb837b] %[output:39e9e14c] %[output:26c13945] %[output:97c1a3dd] %[output:51926985] %[output:9421a488] %[output:96454fbc] %[output:880e6394] %[output:6e0e3d59] %[output:42e85af7] %[output:22591fbb]
        devvals(n) = std(max_window) %[output:8373aace] %[output:1585f6d1] %[output:74deb9b5] %[output:9532bb9d] %[output:5a628ef9] %[output:9e51e3ca] %[output:6d441c2d] %[output:9d3079c0] %[output:262ee1b9] %[output:181ebeb4] %[output:98bded87] %[output:9202035c] %[output:8b7e6df5] %[output:93e78239] %[output:2c9a3c0d] %[output:65bc35c7] %[output:8506da10] %[output:87381c28] %[output:80aea626] %[output:31404b8c] %[output:05d8ed2a] %[output:26d5d6d4] %[output:75605388] %[output:98c271bb] %[output:4604e903] %[output:6f580383] %[output:228bdaf7] %[output:566647d6] %[output:7a0f3d6c] %[output:50482afc] %[output:8597593d] %[output:2edc1483] %[output:7ce16d41] %[output:49dd1e4f] %[output:9996c2da] %[output:674ba0ae] %[output:9f4d0601] %[output:4bfcc0d6] %[output:08185f9a] %[output:8cfd9960] %[output:118f8514] %[output:1f8a6dde] %[output:1dfb09b4] %[output:601be80d] %[output:5be02d40] %[output:8f62ef8d] %[output:722dae5a] %[output:8b333387] %[output:0d1ef039] %[output:356ffd24] %[output:044e7cfd] %[output:89588183] %[output:2bdc7a4d] %[output:5694b9bf] %[output:233eee03] %[output:7026a95f] %[output:7300f420] %[output:3cdea048] %[output:4a8c5437] %[output:13952c6e] %[output:2c322525] %[output:9edc8762] %[output:518c1f9c] %[output:65f75936] %[output:8b601109] %[output:282a3ffb] %[output:6030c1bf] %[output:5b9016a6] %[output:672928f9] %[output:251cf5d5] %[output:24622bb6] %[output:42689c92] %[output:94173494] %[output:0baf6348] %[output:7b187bf5] %[output:623fe514] %[output:861c9e5a] %[output:48b83931] %[output:47d8403a] %[output:33749379] %[output:885a2f81] %[output:22c07b91] %[output:4646df28] %[output:565c466e] %[output:56c2bf32] %[output:11b510ac] %[output:86d89f90] %[output:9160f667] %[output:087b0791] %[output:046630a1] %[output:8c2bfe9e] %[output:2464bc36] %[output:96c1bbc2] %[output:0c6d2f3c] %[output:7b7a7ae2]
        if devvals(n)
            
        end
        p_current = p_current-mfactor;


    else 
        p_current = p_current-mfactor;
    end



    % DEBUG
    p_current_vals(n) = p_current;
    momentum_vals(n)  = momentum;
    p_best_vals(n)    = p_best;
    p_step_vals(n)    = p_step;
    fprintf("p_cur: %.2f | p_best: %.2f | best_val: %.4f | momentum: %.2f | p_step: %.4f \n",p_current, p_best, best_val, momentum, p_step); %[output:5b7c7db1] %[output:435dc30c] %[output:998d6c63] %[output:1af9c8e0] %[output:865c7f13] %[output:91bfe4e2] %[output:92f54b77] %[output:24d93f0e] %[output:9313e8e2] %[output:68e6b379] %[output:45542dbd] %[output:4cd4f575] %[output:05aad14a] %[output:21df8170] %[output:397dde52] %[output:88e9ee4d] %[output:89f516fb] %[output:0b04b5b5] %[output:4197aace] %[output:52a41a00] %[output:49657e63] %[output:6bde3ab6] %[output:72015e9b] %[output:7e0418a2] %[output:45a12a59] %[output:8bf91f3d] %[output:8cc184e9] %[output:525ed4d2] %[output:50887829] %[output:1093b4d0] %[output:714f8d8f] %[output:8beb5df6] %[output:1e5980eb] %[output:8d4654cb] %[output:3be76fb7] %[output:94d59637] %[output:5c359997] %[output:33e5d3ff] %[output:48e07bd6] %[output:37e16ccc] %[output:240e0540] %[output:411f9489] %[output:6afd5f3f] %[output:8cc10db9] %[output:22a3564b] %[output:908b573e] %[output:02f6e75a] %[output:8b3a4cbf] %[output:63bcdbdc] %[output:95a35672] %[output:59958fe0] %[output:2f91b1bc] %[output:7aba6600] %[output:197ff5f6] %[output:2b50e9f5] %[output:4fbe1209] %[output:1d6030c2] %[output:88abb53c] %[output:41ccb906] %[output:32e0a35b] %[output:32972fd0] %[output:0a1a5b46] %[output:3953a5ee] %[output:7ba43a93] %[output:4988ea2e] %[output:5eb1cb59] %[output:245e0a3b] %[output:95519161] %[output:2e0e4b51] %[output:4233010b] %[output:89fb3586] %[output:85d3426c] %[output:7bd2635a] %[output:0bfc53ce] %[output:07837874] %[output:3888ffe4] %[output:6f89c622] %[output:76886f8e] %[output:8cb195c1] %[output:8e0e7079] %[output:44e98ad8] %[output:93b02722] %[output:0deaf010] %[output:2cc7fdec] %[output:4b8bc9e5] %[output:69674158] %[output:3c9be7a3] %[output:91edc1ad] %[output:1c19fe4f] %[output:9390180c] %[output:771ac875] %[output:0cf81040] %[output:05707516] %[output:5c651791] %[output:6a1dab0e] %[output:4bddd99e] %[output:05563cc8] %[output:23bfd5d7] %[output:04a0f5ac] %[output:5366186e]
    

end %[output:group:2541db5a]
