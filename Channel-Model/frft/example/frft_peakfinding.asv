%[text] # Peak Search in FRFT Domain
%[text:tableOfContents]{"heading":"Table of Contents"}
%[text] ## Input Signal
% Signal
fs = 1.1*(2*10.8e3 + 5e3);
T  = 0.10;
%t  =  linspace(-T/2,T/2,fs*T);
t  =  linspace(-T,T,fs*T);
B  = fs/2;
k  = B/(T);
f0 = 0;
A  = 100;
s1_signal =  A*exp(1i * 2*pi * (f0.*t + 0.5*k.*t.^2));
padsize = ceil((1-T)*fs/2);
s1 = [zeros(1,padsize), s1_signal, zeros(1,padsize)];
t  = [-T/2 - padsize/fs: 1/fs : T/2 + padsize/fs - 1/fs];

figure %[output:8c1feb34]
hold on %[output:8c1feb34]
plot(t,real(s1)) %[output:8c1feb34]
title("Chirp Signal") %[output:8c1feb34]
hold off %[output:8c1feb34]
%%
%[text] ## Windowing
% Assume that signal runs from -T/2 -> +T/2
% Therefore no zeros, just cos term
function out = hamming(gamma,sig)
    window = gamma+(1-gamma)*cos(2*pi* linspace( -1/2,+1/2,length(sig) ) );
    out = window.*sig;
end

figure %[output:6a6bb137]
hold on %[output:6a6bb137]
plot(t,real(s1),t,imag(s1)); %[output:6a6bb137]
title("Chirp Signal Windowed") %[output:6a6bb137]
hold off %[output:6a6bb137]
%[text] ## Adding Comms Signal
rrc_filter = comm.RaisedCosineTransmitFilter(RolloffFactor=0.3, ...
        Shape='Normal', ...
        FilterSpanInSymbols=10, ...
        OutputSamplesPerSymbol=2);
%rrc_filter.Gain = 1/max(coeffs(rrc_filter).Numerator)
rng(1) % Set seed for repeatability
s2_bits = round(rand(1,floor((length(t)*(1/fs))*2000)));
%s2_bits = zeros(1,length(t)/270);

%s2_bits(1:2:end) = half(1);
%s2_signal = 2*(s2_bits-0.5); % polar nrz
%s2_signal = pskmod(s2_bits,2,pi/4,PlotConstellation=true);
s2_signal = fskmod(s2_bits,2,0.5*fs/2,ceil(length(t) / length(s2_bits)),fs);


s2 = s2_signal;
%s2 = rrc_filter(s2_signal);
%s2 = s2(:)';
max(s2) %[output:95b85298]
figure %[output:0c8fe15b]
hold on %[output:0c8fe15b]
plot(real(s2)) %[output:0c8fe15b]
plot(imag(s2)) %[output:0c8fe15b]
hold off %[output:0c8fe15b]
% Shift to IF and low pass
fc = half(1e3);
s2 = s2(1:length(t)).*sin(2*pi*fc*t);

max(s2) %[output:3d932bba]

%s2 = awgn(s2,20);



max(s2) %[output:3964ddff]

s = 1*s1 + s2;

%s = [zeros(1,padsize), s, zeros(1,padsize)];
%t = [-T/2 - padsize/fs: 1/fs : T/2 + padsize/fs - 1/fs];

%s = hamming(0.54,s);

s = single(s) %[output:1f64c9f5]

figure %[output:95316d68]
plot(real(s)) %[output:95316d68]
hold on %[output:95316d68]
plot(imag(s)) %[output:95316d68]
hold off %[output:95316d68]
%[text] fourier domain:
fft_n_points = 10000;
s2_bb_fft = fft(s2_signal,fft_n_points);
s2_fc_fft = fft(s2,       fft_n_points);
s1_fft    = fft(s1,       fft_n_points);
F = linspace(0,1,fft_n_points/2).*(fs/2);

figure %[output:4cb24600]
subplot(3,1,1) %[output:4cb24600]
plot(F,10*log10(abs(s2_bb_fft(1:fft_n_points/2)).^2)); %[output:4cb24600]
title("Comms Signal @ Baseband") %[output:4cb24600]

subplot(3,1,2) %[output:4cb24600]
plot(F,10*log10(abs(s2_fc_fft(1:fft_n_points/2)).^2)); %[output:4cb24600]
title("Comms Signal @ IF") %[output:4cb24600]

subplot(3,1,3) %[output:4cb24600]
plot(F,10*log10(abs(s1_fft(1:fft_n_points/2)).^2)); %[output:4cb24600]
title("") %[output:4cb24600]
%%
%[text] Let's have a look at it in frft domain:
p = 0: 1 / 400 : 2;

s_frft = zeros(length(p),length(s));

for i = 1:length(p)
    s_frft(i,:) = frft(s,p(i));
end

s_frft_sqmag = abs(s_frft).^2;

fig = figure();  %[output:8a9ec5eb]
fig.Position(3:4) = [1000, 500]; %[output:8a9ec5eb]

subplot(2,1,1) %[output:8a9ec5eb]
frft_plot = imagesc(p,0:length(s)-1,10*log10(s_frft_sqmag)); %[output:8a9ec5eb]
xlabel('p') %[output:8a9ec5eb]
ylabel(" u ") %[output:8a9ec5eb]
zlabel("|X_\alpha (u)|^2") %[output:8a9ec5eb]
colormap(gca,hot), colorbar %[output:8a9ec5eb]
%Place datatip at peak value
[frft_maxval,frft_maxidx] = max(s_frft_sqmag,[],"all");
frft_maxtip = datatip(frft_plot,'DataIndex',frft_maxidx,'Location','southwest'); %[output:8a9ec5eb]
frft_plot.DataTipTemplate.DataTipRows(end+1) = dataTipTextRow("Magnitude",s_frft_sqmag); %[output:8a9ec5eb]

subplot(2,1,2) %[output:8a9ec5eb]
plot(p,max(10*log10(s_frft_sqmag'))) %[output:8a9ec5eb]
ylabel("max(|X_\alpha (u)|^2)") %[output:8a9ec5eb]

hold on; %[output:8a9ec5eb]
p_opt = p(mod(frft_maxidx,length(p))) %[output:7ec9c219]
xline(p_opt, 'r--', 'LineWidth', 1.5); %[output:8a9ec5eb]
hold off; %[output:8a9ec5eb]
%%
%[text] ## Algorithm
%[text] Basic Gradient ascent
%[text] For each iteration:
%[text] 1. Calculate FRFT
%[text] 2. Find max(frft(alpha))
%[text] 3.  \
%[text] Next iteration:
%[text] 1. Is current \> best? Y -\> current = best \
%[text]  
p_bounds = [0 2]; %[control:rangeslider:0a7a]{"position":[12,17]}

% One order lower than the difference in bounds.
p_step     = 10^(floor(log10(p_bounds(2)-p_bounds(1)))-1);

p_current  = p_bounds(2);
p_previous = 0;
frft_current = zeros(1,length(s));

max_steps = 50; %[control:editfield:37eb]{"position":[13,15]}
p_vals = zeros(1,max_steps);

[p_best, best_val] = find_frft_peak(s, max_steps, p_bounds, false) %[output:02b7579c] %[output:3dd9d4b7]
%%
%[text] ## Comparing Comms Sig + Isolated
s_frft  = frft(s, p_best);
s1_frft = frft(s1,p_best);
s2_frft = frft(s2,p_best);


figure %[output:4bf792a4]
hold on %[output:4bf792a4]

subplot(4,1,1) %[output:4bf792a4]
plot((abs(s_frft).^2)); %[output:4bf792a4]
title("Combined Signal") %[output:4bf792a4]

subplot(4,1,2) %[output:4bf792a4]
plot((abs(s1_frft).^2)); %[output:4bf792a4]
title("Chirp") %[output:4bf792a4]

subplot(4,1,3) %[output:4bf792a4]
plot((abs(s2_frft).^2)); %[output:4bf792a4]
title("Comms Signal") %[output:4bf792a4]
subplot(4,1,4) %[output:4bf792a4]
plot((abs(s_frft).^2)); %[output:4bf792a4]
ylim([0, 1.1*max((abs(s2_frft).^2))]) %[output:4bf792a4]
title("Combined Signal scaled to comms") %[output:4bf792a4]
%%
%[text] ## IFRFT Peak Suppression
% s_frft_sqmag = abs(s_frft).^2;
% s_frft_sqmag_sdev = std(s_frft_sqmag);
% 
% s_frft_cancelled = s2_frft - s_frft ;
% 
% figure
% hold on
% 
% subplot(4,1,1)
% plot(10*log10(abs(frft(s,p_best)).^2));
% title("Combined Signal")
% 
% subplot(4,1,2)
% plot(10*log10(abs(frft(s1,p_best)).^2));
% title("Chirp")
% 
% subplot(4,1,3)
% plot(10*log10(abs(frft(s2,p_best)).^2));
% title("Comms Signal")
% 
% subplot(4,1,4)
% plot(10*log10(abs(s_frft_cancelled.^2)));
% title("Error between combined and comms Signal")

%s_cancelled = frft(s_frft_cancelled,-p_best);


figure %[output:3f373bb5]
hold on %[output:3f373bb5]
subplot(4,1,1) %[output:3f373bb5]
hold on %[output:3f373bb5]
plot(t,real(s1),DisplayName="Real") %[output:3f373bb5]
plot(t,imag(s1),DisplayName="Imaginary") %[output:3f373bb5]
title("Chirp") %[output:3f373bb5]

subplot(4,1,2) %[output:3f373bb5]
hold on %[output:3f373bb5]
plot(t,real(s2),DisplayName="Real") %[output:3f373bb5]
plot(t,imag(s2),DisplayName="Imaginary") %[output:3f373bb5]
title("Comms Signal") %[output:3f373bb5]

subplot(4,1,3) %[output:3f373bb5]
hold on %[output:3f373bb5]
plot(t,real(s),DisplayName="Real") %[output:3f373bb5]
plot(t,imag(s),DisplayName="Imaginary") %[output:3f373bb5]
title("Combined Signal") %[output:3f373bb5]

subplot(4,1,4) %[output:3f373bb5]
hold on %[output:3f373bb5]
%plot(t,real(s_cancelled),DisplayName="Real")
%plot(t,imag(s_cancelled),DisplayName="Imaginary")
%title("Cancelled Signal")
%%
%[text] ## Windowing FRFT size
%[text] In implementation paper, they've provided timings for 100 iterations on 1024 bin size as 12.98ms for area optimised, and 5.22 for speed optimised.
%[text] Let's try this out on the signal components and create some 3d plots.
window_size = 1024; %[control:editfield:46fb]{"position":[15,19]}
max_steps   = 100; %[control:editfield:4c51]{"position":[15,18]}
window = zeros(1,window_size);
% Add overlap here?



% Combined Signal
n_windows_s = ceil(length(s)/window_size);
% 0 Pad to window size.
s_padded = [s, zeros(1,mod(length(s),window_size))];


frft_arr_s = zeros(window_size,n_windows_s);
s_windowed = zeros(window_size,n_windows_s);

for n = 0:n_windows_s-1
   window = s_padded(1+n*window_size:(n+1)*window_size);

    s_windowed(:,n+1) = window;
   p_best = find_frft_peak(window, max_steps, p_bounds, false);

   frft_arr_s(:,n+1) = frft(window,p_best);
end
%%
fig = figure();  %[output:7a83dc50]
frft_surf_s = surface(0:n_windows_s-1,0:window_size-1,10*log10(abs(frft_arr_s))); %[output:7a83dc50]
shading interp %[output:7a83dc50]
view([344 61]) %[output:7a83dc50]

colorbar %[output:7a83dc50]

fig = figure();  %[output:74d40cce]
frft_surf_s = surface(0:n_windows_s-1,0:window_size-1,10*log10(abs(fft(s_windowed)))); %[output:74d40cce]
shading interp %[output:74d40cce]
view([344 61]) %[output:74d40cce]
colorbar %[output:74d40cce]
fig = figure();  %[output:8d74faf6]
frft_surf_s = surface(0:n_windows_s-1,0:window_size-1,10*log10(abs(half(frft_arr_s)))); %[output:8d74faf6]
shading interp %[output:8d74faf6]
view([344 61]) %[output:8d74faf6]

colorbar %[output:8d74faf6]
fig = figure();  %[output:0a0dc975]
frft_surf_s = surface(0:n_windows_s-1,0:window_size-1,10*log10(abs(fft(half(s_windowed))))); %[output:0a0dc975]
shading interp %[output:0a0dc975]
view([344 61]) %[output:0a0dc975]
colorbar %[output:0a0dc975]
%%
%[text] ## Recovery w. Quantisation
%[text] ### Windowing the Signals
% 0 Pad to window size.
s1_padded = [s1, zeros(1,mod(length(s1),window_size))];
s2_padded = [s2, zeros(1,mod(length(s2),window_size))];

s1_windowed = zeros(window_size,n_windows_s);
s2_windowed = zeros(window_size,n_windows_s);

for n = 0:n_windows_s-1
   s1_window = s1_padded(1+n*window_size:(n+1)*window_size);
   s1_windowed(:,n+1) = s1_window;

   s2_window = s2_padded(1+n*window_size:(n+1)*window_size);
   s2_windowed(:,n+1) = s2_window;
end
%%
%[text] ### Quantizing to 14 bit ADC
%[text] 14 bits, 13 fractional for I and Q
%[text] Normalising by max of s, Using the optimal gain for each window of s, to assume optimal AGC
for n = 0:n_windows_s-1
    gain(n+1) = 1*max(abs(s_windowed(:,n+1)));
    
    adc_bits = 14;
    adc_frac = adc_bits - 1;

    s_windowed_sfix(:,n+1)  = fi(s_windowed(:,n+1) ./ gain(n+1),1,adc_bits,adc_frac);
    s1_windowed_sfix(:,n+1) = fi(s1_windowed(:,n+1) ./ gain(n+1),1,adc_bits,adc_frac);
    s2_windowed_sfix(:,n+1) = fi(s2_windowed(:,n+1) ./ gain(n+1),1,adc_bits,adc_frac);

end


for n = 0:n_windows_s-1
   s_window = s_windowed_sfix(1+n*window_size:(n+1)*window_size);
   s_window = hamming(0.9,s_window);
   p_best_arr(n+1) = find_frft_peak(double(s_window), max_steps, p_bounds, false);
   s_windowed_frft_sfix(:,n+1) = frft(s_window,p_best_arr(n+1));

   s1_window = s1_windowed_sfix(1+n*window_size:(n+1)*window_size);
   s1_window = hamming(0.5,s1_window);
   %p_best = find_frft_peak(double(s1_window), max_steps, p_bounds, false);
   s1_windowed_frft_sfix(:,n+1) = frft(s1_window,p_best_arr(n+1));

   s2_window = s2_windowed_sfix(1+n*window_size:(n+1)*window_size);
   s2_window = hamming(0.5,s2_window);
   %p_best = find_frft_peak(double(s2_window), max_steps, p_bounds, false);
   s2_windowed_frft_sfix(:,n+1) = frft(double(s2_window),p_best_arr(n+1));
end

%%
%[text] ### Plotting Windowed Signals
fig = figure();  %[output:24b25913]
frft_surf_s = surface(0:n_windows_s-1,0:window_size-1,10*log10(abs(s_windowed_frft_sfix))); %[output:24b25913]
shading interp %[output:24b25913]
view([344 61]) %[output:24b25913]
colorbar %[output:24b25913]
fig = figure();  %[output:83d31de5]
frft_surf_1 = surface(0:n_windows_s-1,0:window_size-1,10*log10(abs(s1_windowed_frft_sfix))); %[output:83d31de5]
shading interp %[output:83d31de5]
view([344 61]) %[output:83d31de5]
colorbar %[output:83d31de5]

fig = figure();  %[output:2e0e560e]
frft_surf_s2 = surface(0:n_windows_s-1,0:window_size-1,10*log10(abs(s2_windowed_frft_sfix))); %[output:2e0e560e]
shading interp %[output:2e0e560e]
view([344 61]) %[output:2e0e560e]
colorbar %[output:2e0e560e]
%%
%[text] ### Converting back to time domain to see  the signal error / window
for n = 0:n_windows_s-1 %[output:group:20b0f448]
   s_frft_window = s_windowed_frft_sfix(1+n*window_size:(n+1)*window_size);
   s_windowed_ifrft_sfix(:,n+1) = frft(s_frft_window,-p_best_arr(n+1));

   s1_frft_window = s1_windowed_frft_sfix(1+n*window_size:(n+1)*window_size);
   s1_windowed_ifrft_sfix(:,n+1) = frft(s1_frft_window,-p_best_arr(n+1));

   s2_frft_window = s2_windowed_frft_sfix(1+n*window_size:(n+1)*window_size);
   s2_windowed_ifrft_sfix(:,n+1) = frft(s2_frft_window,-p_best_arr(n+1));


   % Cancelling by zeroing everything in frft > threshold
   thresh = 1;
   s_frft_cancelled(:,n+1)  =  s_frft_window - (s_frft_window .* (abs(s_frft_window) > thresh)) %[output:15e3f5d3] %[output:8e3933e5] %[output:2a101d29] %[output:04d92df5] %[output:95a43a50] %[output:67896c92] %[output:3a9f501c] %[output:52403a57] %[output:745b0076] %[output:54c1ad74] %[output:1dce83f0] %[output:398c8429] %[output:007acb4c] %[output:7c6d95e1] %[output:7a4594a8] %[output:0c5d81e8] %[output:57ce07d8] %[output:858fad47] %[output:9bdf1c4e] %[output:6877d237] %[output:6193a490] %[output:92d2532e] %[output:2b1132d8] %[output:5d35826a] %[output:01858fe6] %[output:7dc77857] %[output:484a8f79] %[output:976b57d3] %[output:469c6cec]
   s1_frft_cancelled(:,n+1) = s1_frft_window - (s1_frft_window .* (abs(s1_frft_window) > thresh))  %[output:212bce8d] %[output:9b192139] %[output:573c2ae7] %[output:9f97af84] %[output:50930313] %[output:8f3dcb3c] %[output:68ece63d] %[output:21ac7604] %[output:204a9335] %[output:2ee97f41] %[output:9263f55f] %[output:761a155c] %[output:27a348de] %[output:6fe4b3bb] %[output:0da61cf3] %[output:10931643] %[output:6bcdb26b] %[output:80b521c3] %[output:3fe4638e] %[output:736f4e09] %[output:2f2c44ee] %[output:29fb5acf] %[output:9e333e96] %[output:7ea7d6a4] %[output:2d039d57] %[output:291a4184] %[output:6b6b2f0b] %[output:3724284d] %[output:15cec64f]
   s2_frft_cancelled(:,n+1) = s2_frft_window - (s2_frft_window .* (abs(s2_frft_window) > thresh)) %[output:77de6918] %[output:4077717c] %[output:4e733b60] %[output:54c42605] %[output:56ab488f] %[output:470988f8] %[output:780a491e] %[output:5af86d15] %[output:87b049c1] %[output:8b4086a9] %[output:0b64c87c] %[output:79027876] %[output:912e69d8] %[output:2139358f] %[output:63d74817] %[output:0a796cbe] %[output:9ee8b684] %[output:89cca545] %[output:131071c6] %[output:43930c94] %[output:19ff7e87] %[output:6aa4c772] %[output:8b20d06e] %[output:1978118e] %[output:7704b4c6] %[output:98573cbb] %[output:6d37d464] %[output:62354b8b] %[output:3ebea4d8]
   
   s_ifrft_cancelled(:,n+1)  = frft(s_frft_cancelled(:,n+1) ,-p_best_arr(n+1));
   s1_ifrft_cancelled(:,n+1) = frft(s1_frft_cancelled(:,n+1),-p_best_arr(n+1));
   s2_ifrft_cancelled(:,n+1) = frft(s2_frft_cancelled(:,n+1),-p_best_arr(n+1));
   


   % Rescale by gain(n)
   s_windowed_ifrft_sfix(:,n+1)  = s_windowed_ifrft_sfix(:,n+1) .* gain(n+1);
   s1_windowed_ifrft_sfix(:,n+1) = s1_windowed_ifrft_sfix(:,n+1) .* gain(n+1);
   s2_windowed_ifrft_sfix(:,n+1) = s2_windowed_ifrft_sfix(:,n+1) .* gain(n+1);

   s_windowed_sfix_descale(:,n+1)  = s_windowed_sfix(:,n+1) .* gain(n+1);
   s1_windowed_sfix_descale(:,n+1) = s1_windowed_sfix(:,n+1) .* gain(n+1);
   s2_windowed_sfix_descale(:,n+1) = s2_windowed_sfix(:,n+1) .* gain(n+1);

   s_ifrft_cancelled(:,n+1)   = s_ifrft_cancelled(:,n+1) .* gain(n+1);
   s1_ifrft_cancelled(:,n+1)  = s1_ifrft_cancelled(:,n+1) .* gain(n+1);
   s2_ifrft_cancelled(:,n+1)  = s2_ifrft_cancelled(:,n+1) .* gain(n+1);
end %[output:group:20b0f448]

% MSE
s_ifrft_sfix_error = mean(abs((s_windowed - s_windowed_ifrft_sfix)).^2);
s1_ifrft_sfix_error = mean(abs((s1_windowed - s1_windowed_ifrft_sfix)).^2);
s2_ifrft_sfix_error = mean(abs((s2_windowed - s2_windowed_ifrft_sfix)).^2);

% MSE
s_sfix_error  = mean(abs((s_windowed  - s_windowed_sfix_descale)).^2);
s1_sfix_error = mean(abs((s1_windowed - s1_windowed_sfix_descale)).^2);
s2_sfix_error = mean(abs((s2_windowed - s2_windowed_sfix_descale)).^2);


figure %[output:00feb568]
hold on %[output:00feb568]
n = 0:n_windows_s-1;
subplot(3,1,1) %[output:00feb568]
plot(n, 10*log10(double(s_sfix_error)), "DisplayName", "S" ); %[output:00feb568]
legend %[output:00feb568]
subplot(3,1,2) %[output:00feb568]
plot(n, 10*log10(double(s1_sfix_error)), "DisplayName", "S1" ); %[output:00feb568]
legend %[output:00feb568]
subplot(3,1,3) %[output:00feb568]
plot(n, 10*log10(double(s2_sfix_error)), "DisplayName", "S2" ); %[output:00feb568]

sgtitle("MSE of Quantized vs Unquantized Time Domain Signal") %[output:00feb568]
ylabel("|e(n)|^2 (dB)") %[output:00feb568]
xlabel("n") %[output:00feb568]
legend %[output:00feb568]
hold off %[output:00feb568]

figure %[output:447ec9f2]
hold on %[output:447ec9f2]
n = 0:n_windows_s-1;
plot(n, 10*log10(s_ifrft_sfix_error), "DisplayName", "S" ); %[output:447ec9f2]
plot(n, 10*log10(s1_ifrft_sfix_error), "DisplayName", "S1" ); %[output:447ec9f2]
plot(n, 10*log10(s2_ifrft_sfix_error), "DisplayName", "S2" ); %[output:447ec9f2]
title("MSE of IFRFT vs Time Domain Signal") %[output:447ec9f2]
subtitle("Quantized to 14 bit ADC") %[output:447ec9f2]
ylabel("|e(n)|^2 (dB)") %[output:447ec9f2]
xlabel("n") %[output:447ec9f2]
legend %[output:447ec9f2]
hold off %[output:447ec9f2]
%%
%[text] ### Looking Specifically at where the chirp comes in 
for n = 12:15 %[output:group:9db45f97]
    figure %[output:5a3164f5] %[output:6f97cbaf] %[output:9260b4ea] %[output:97f7df7e]

    subplot(4,1,1) %[output:5a3164f5] %[output:6f97cbaf] %[output:9260b4ea] %[output:97f7df7e]
    sgtitle("N="+num2str(n))
    plot(real(s_windowed_sfix(:,n+1)));
    title("S (time)")
    hold on
    
    hold off
    
    subplot(4,1,2)
    plot(real(s2_windowed_sfix(:,n+1)));

    subplot(4,1,3)
    plot(abs(s_windowed_frft_sfix(:,n+1)));
    a = s_windowed(:,n+1)./gain(n+1);
    a_sfix = fi(a,1,14,13);
    %plot(real(a_sfix));

    subplot(4,1,4)
    plot(real(a_sfix));
    hold on 
    plot(imag(a_sfix ));
    

end %[output:group:9db45f97]
%%
for n = 12:15 %[output:group:1c2165bd]
    
    s_sfix_double(:,n+1) = double(s_windowed_sfix(:,n+1)).*gain(n+1);
    s_error(:,n+1) = s_sfix_double(:,n+1) - s_windowed_ifrft_sfix(:,n+1);

    cancelled = s_sfix_double(:,n) %[output:186505f2] %[output:58b42631] %[output:3abcc09f] %[output:821e1a9f]



    figure %[output:62c84ff0] %[output:8ef0e10c] %[output:1a0c271c] %[output:415097b0]

    subplot(4,1,1) %[output:62c84ff0] %[output:8ef0e10c] %[output:1a0c271c] %[output:415097b0]
    sgtitle("N="+num2str(n))
    plot(real(s_sfix_double(:,n+1)));
    title("S (time)")
    hold on
    plot(real(s_windowed_ifrft_sfix(:,n+1)),"-")
    hold off
    
    subplot(4,1,2)
    plot(real(s_error(:,n+1)));
    title("S IFRFT")

    subplot(4,1,3)
    plot(abs(s_windowed_frft_sfix(:,n+1)));
    a = s_windowed(:,n+1)./gain(n+1);
    a_sfix = fi(a,1,14,13);
    %plot(real(a_sfix));

    subplot(4,1,4)
    plot(real(a_sfix));
    hold on 
    plot(imag(a_sfix ));
    

end %[output:group:1c2165bd]
%%
%[text] ## Parameter Estimation
S = sqrt(T/fs)
est_phi = pi/2 * p_best;
est_f0 = s_frft
%[text] ## References
%[text] \[1\] X. Chen, J. Guan, S. Yu, and Y. He, 'A novel adaptive filtering for LFM signal in FRFT domain', in IEEE 10th INTERNATIONAL CONFERENCE ON SIGNAL PROCESSING PROCEEDINGS, Oct. 2010, pp. 239–242. doi: 10.1109/ICOSP.2010.5655204.  
%[text]  

