%[text] # Peak Search in FRFT Domain
%[text:tableOfContents]{"heading":"Table of Contents"}
%[text] ## Input Signal
% Signal
fs = 5000;
T = 0.25;
t = -T/2: 1/fs : T/2 - 1/fs;
B = fs/2;
k = B/(2*T);
f0 = 0;
A = 100;

s1 =  A*exp(1i * 2*pi * (f0.*t + 0.5*k.*t.^2));
padsize = 100;
s1 = [zeros(1,padsize), s1, zeros(1,padsize)];
t = [-T/2 - padsize/fs: 1/fs : T/2 + padsize/fs - 1/fs];




figure %[output:93a8db82]
hold on %[output:93a8db82]
plot(t,real(s1),t,imag(s1)); %[output:93a8db82]
title("Chirp Signal") %[output:93a8db82]
hold off %[output:93a8db82]
%[text] ## Windowing
% Assume that signal runs from -T/2 -> +T/2
% Therefore no zeros, just cos term
function out = hamming(gamma,sig)
    window = gamma+(1-gamma)*cos(2*pi* linspace( -1/2,+1/2,length(sig) ) );
    out = window.*sig;
end

s1 = hamming(0.5,s1);


figure %[output:27b19d7d]
hold on %[output:27b19d7d]
plot(t,real(s1),t,imag(s1)); %[output:27b19d7d]
title("Chirp Signal Windowed") %[output:27b19d7d]
hold off %[output:27b19d7d]
%[text] ## Adding Comms Signal


rrc_filter = comm.RaisedCosineTransmitFilter(RolloffFactor=0.3, ...
        Shape='Normal', ...
        FilterSpanInSymbols=10, ...
        OutputSamplesPerSymbol=2);
%rrc_filter.Gain = 1/max(coeffs(rrc_filter).Numerator)
rng(1) % Set seed for repeatability
%s2_bits = round(rand(1,length(t)/10));
s2_bits = zeros(1,length(t)/10);
s2_bits(1:2:end) = 1;
%s2_signal = 2*(s2_bits-0.5); % polar nrz
%s2_signal = pskmod(s2_bits,2,pi/4,PlotConstellation=true);
s2_signal = fskmod(s2_bits,2,0.5*fs/2,10,fs) %[output:8128c577]


s2 = rrc_filter(s2_signal);
s2 = s2(:)';
max(s2) %[output:7c86a049]

% Shift to IF and low pass
fc = 1e3;
s2 = s2.*sin(2*pi*fc*t); %[output:125c3773]

s2 = lowpass(s2,fs/2 *0.9,fs);
max(s2)

s2 = awgn(s2,20);
max(s2)

s = 10*s1 + s2;
%[text] Let's have a look at it in frft domain:
p = 0: 1 / 400 : 2;

s_frft = zeros(length(p),length(s));

for i = 1:length(p)
    s_frft(i,:) = frft(s,p(i));
end

s_frft_sqmag = abs(s_frft).^2;

fig = figure(); 
fig.Position(3:4) = [1000, 500];

subplot(2,1,1)
frft_plot = imagesc(p,0:length(s)-1,10*log10(s_frft_sqmag));
xlabel('p')
ylabel(" u ")
zlabel("|X_\alpha (u)|^2")
colormap(gca,hot), colorbar
%Place datatip at peak value
[frft_maxval,frft_maxidx] = max(s_frft,[],"all");
frft_maxtip = datatip(frft_plot,'DataIndex',frft_maxidx,'Location','southwest');
frft_plot.DataTipTemplate.DataTipRows(end+1) = dataTipTextRow("Magnitude",s_frft_sqmag);

subplot(2,1,2)
plot(p,max(10*log10(s_frft_sqmag')))
ylabel("max(|X_\alpha (u)|^2)")

hold on;
p_opt = p(mod(frft_maxidx,length(p)))
xline(p_opt, 'r--', 'LineWidth', 1.5);
hold off;
%%
%[text] ## Algorithm
%[text] Basic Gradient ascent
%[text] For each iteration:
%[text] 1. Calculate FRFT
%[text] 2. Find max(frft(alpha)) \
function peakval = get_frft_pk(sig,p)
    peakval = max(frft(sig,p))
end
%[text] Next iteration:
%[text] 1. Is current \> best? Y -\> current = best \
%[text]  
p_bounds = [0.5 1.5]; %[control:rangeslider:0a7a]{"position":[12,21]}

% One order lower than the difference in bounds.
p_step     = 10^(floor(log10(p_bounds(2)-p_bounds(1)))-1);

p_best     = 0;
p_current  = p_bounds(2);
p_previous = 0;
best_val   = 0;
frft_current = zeros(1,length(s));




max_steps = 1000; %[control:editfield:37eb]{"position":[13,17]}
p_vals = zeros(1,max_steps);

for n = 1:max_steps
    p_vals(n) = p_best;

    if p_current > p_bounds(1)
        frft_current = frft(s,p_current);
        curmax = max(abs(frft_current).^2);

        if curmax > best_val
            best_val = curmax;
            p_best = p_current;
        end
        p_current = p_current - p_step;

    else
        p_bounds(1) = p_best - p_step;
        p_bounds(2) = p_best + p_step;
        p_current = p_bounds(2);
        p_step = p_step*0.1;
    end

    
    % DEBUG
    % p_current_vals(n) = p_current;
    % momentum_vals(n)  = momentum;
    % p_best_vals(n)    = p_best;
    % p_step_vals(n)    = p_step;
     fprintf("%.0f> p_cur: %.2f | p_best: %.2f | best_val: %.4f | p_step: %.4f \n",n,p_current, p_best, best_val, p_step);
    % 

end
%%
%[text] ## Comparing Comms Sig + Isolated
figure
hold on

subplot(3,1,1)
plot((abs(frft(s,p_best)).^2));
title("Combined Signal")

subplot(3,1,2)
plot((abs(frft(s1,p_best)).^2));
title("Chirp")

subplot(3,1,3)
plot((abs(frft(s2,p_best)).^2));
title("Comms Signal")
%%
%[text] ## IFRFT Peak Suppression
s_frft = frft(s,p_best);
s_frft_sqmag = abs(s_frft).^2;
s_frft_sqmag_sdev = std(s_frft_sqmag);

s_frft_cancelled = s_frft .* ~(s_frft_sqmag > 15);
figure
hold on

subplot(4,1,1)
plot(10*log10(abs(frft(s,p_best)).^2));
title("Combined Signal")

subplot(4,1,2)
plot(10*log10(abs(frft(s1,p_best)).^2));
title("Chirp")

subplot(4,1,3)
plot(10*log10(abs(frft(s2,p_best)).^2));
title("Comms Signal")

subplot(4,1,4)
plot(10*log10(abs(s_frft_cancelled.^2)));
title("Cancelled Signal")

s_cancelled = frft(s_frft_cancelled,-p_best);


figure
hold on
subplot(4,1,1)
hold on
plot(t,real(s1),DisplayName="Real")
plot(t,imag(s1),DisplayName="Imaginary")
title("Chirp")

subplot(4,1,2)
hold on
plot(t,real(s2),DisplayName="Real")
plot(t,imag(s2),DisplayName="Imaginary")
title("Comms Signal")

subplot(4,1,3)
hold on
plot(t,real(s),DisplayName="Real")
plot(t,imag(s),DisplayName="Imaginary")
title("Combined Signal")

subplot(4,1,4)
hold on
plot(t,real(s_cancelled),DisplayName="Real")
plot(t,imag(s_cancelled),DisplayName="Imaginary")
title("Cancelled Signal")
%%
%[text] ## Parameter Estimation
S = sqrt(T/fs)

est_phi = pi/2 * p_best;
est_f0 = s_frft

%[text] ## References
%[text] \[1\] X. Chen, J. Guan, S. Yu, and Y. He, 'A novel adaptive filtering for LFM signal in FRFT domain', in IEEE 10th INTERNATIONAL CONFERENCE ON SIGNAL PROCESSING PROCEEDINGS, Oct. 2010, pp. 239–242. doi: 10.1109/ICOSP.2010.5655204.  
%[text]  

