%[text] # Peak Search in FRFT Domain
%[text:tableOfContents]{"heading":"Table of Contents"}
%[text] ## Input Signal
% Signal
fs = 1.1*(2*10.8e3 + 5e3);
T  = 0.25;
t  =  linspace(-T/2,T/2,fs*T);
B  = fs/2;
k  = B/(2*T);
f0 = 0;
A  = 100;
s1_signal =  A*exp(1i * 2*pi * (f0.*t + 0.5*k.*t.^2));
padsize = ceil((1-T)*fs/2); %[output:553a5dde]
s1 = [zeros(1,padsize), s1_signal, zeros(1,padsize)];
t  = [-T/2 - padsize/fs: 1/fs : T/2 + padsize/fs - 1/fs];


figure %[output:77138b67]
hold on %[output:77138b67]
plot(t,real(s1)) %[output:77138b67]
title("Chirp Signal") %[output:77138b67]
hold off %[output:77138b67]
%%
%[text] ## Windowing
% Assume that signal runs from -T/2 -> +T/2
% Therefore no zeros, just cos term
function out = hamming(gamma,sig)
    window = gamma+(1-gamma)*cos(2*pi* linspace( -1/2,+1/2,length(sig) ) );
    out = window.*sig;
end

figure %[output:3fb4d221]
hold on %[output:3fb4d221]
plot(t,real(s1),t,imag(s1)); %[output:3fb4d221]
title("Chirp Signal Windowed") %[output:3fb4d221]
hold off %[output:3fb4d221]
%[text] ## Adding Comms Signal
rrc_filter = comm.RaisedCosineTransmitFilter(RolloffFactor=0.3, ...
        Shape='Normal', ...
        FilterSpanInSymbols=10, ...
        OutputSamplesPerSymbol=2);
%rrc_filter.Gain = 1/max(coeffs(rrc_filter).Numerator)
rng(1) % Set seed for repeatability
s2_bits = round(rand(1,floor((length(t)*(1/fs))*2000)));
%s2_bits = zeros(1,length(t)/270);

%s2_bits(1:2:end) = half(1);
%s2_signal = 2*(s2_bits-0.5); % polar nrz
%s2_signal = pskmod(s2_bits,2,pi/4,PlotConstellation=true);
s2_signal = fskmod(s2_bits,2,0.5*fs/2,ceil(length(t) / length(s2_bits)),fs);


s2 = s2_signal;
%s2 = rrc_filter(s2_signal);
%s2 = s2(:)';
max(s2) %[output:8958ab7d]
figure %[output:6b10a5bd]
hold on %[output:6b10a5bd]
plot(real(s2)) %[output:6b10a5bd]
plot(imag(s2)) %[output:6b10a5bd]
hold off %[output:6b10a5bd]
% Shift to IF and low pass
fc = half(1e3);
s2 = s2(1:length(t)).*sin(2*pi*fc*t);

s2 = lowpass(single(s2),single(fs)/2 *0.9,single(fs));
max(s2) %[output:59380f49]

%s2 = awgn(s2,20);



max(s2) %[output:0911ecc5]

s = 10*s1 + s2;

%s = [zeros(1,padsize), s, zeros(1,padsize)];
%t = [-T/2 - padsize/fs: 1/fs : T/2 + padsize/fs - 1/fs];

s = hamming(0.54,s);

s = single(s) %[output:5a34757f]

figure %[output:6e53ff9d]
plot(real(s)) %[output:6e53ff9d]
hold on %[output:6e53ff9d]
plot(imag(s)) %[output:6e53ff9d]
hold off %[output:6e53ff9d]
%[text] fourier domain:
s2_bb_fft = fft(s2_signal,4096);
s2_fc_fft = fft(s2,       4096);
s1_fft = fft(s1,          4096);
F = linspace(0,1,2048).*(fs/2);

figure %[output:83570cbb]
subplot(3,1,1) %[output:83570cbb]
plot(F,10*log10(abs(s2_bb_fft).^2)); %[output:2a12f9e0]

subplot(3,1,2)
plot(F,10*log10(abs(s2_fc_fft).^2));

subplot(3,1,3)
plot(F,10*log10(abs(s1_fft).^2));

%%
%[text] Let's have a look at it in frft domain:
p = 0: 1 / 400 : 2;

s_frft = zeros(length(p),length(s));

for i = 1:length(p)
    s_frft(i,:) = frft(s,p(i));
end

s_frft_sqmag = abs(s_frft).^2;

fig = figure();  %[output:6a8066bb]
fig.Position(3:4) = [1000, 500]; %[output:6a8066bb]

subplot(2,1,1) %[output:6a8066bb]
frft_plot = imagesc(p,0:length(s)-1,10*log10(s_frft_sqmag)); %[output:6a8066bb]
xlabel('p') %[output:6a8066bb]
ylabel(" u ") %[output:6a8066bb]
zlabel("|X_\alpha (u)|^2") %[output:6a8066bb]
colormap(gca,hot), colorbar %[output:6a8066bb]
%Place datatip at peak value
[frft_maxval,frft_maxidx] = max(s_frft_sqmag,[],"all");
frft_maxtip = datatip(frft_plot,'DataIndex',frft_maxidx,'Location','southwest'); %[output:6a8066bb]
frft_plot.DataTipTemplate.DataTipRows(end+1) = dataTipTextRow("Magnitude",s_frft_sqmag); %[output:6a8066bb]

subplot(2,1,2) %[output:6a8066bb]
plot(p,max(10*log10(s_frft_sqmag'))) %[output:6a8066bb]
ylabel("max(|X_\alpha (u)|^2)") %[output:6a8066bb]

hold on; %[output:6a8066bb]
p_opt = p(mod(frft_maxidx,length(p))) %[output:5c27d266]
xline(p_opt, 'r--', 'LineWidth', 1.5); %[output:6a8066bb]
hold off; %[output:6a8066bb]
%%
%[text] ## Algorithm
%[text] Basic Gradient ascent
%[text] For each iteration:
%[text] 1. Calculate FRFT
%[text] 2. Find max(frft(alpha)) \
function peakval = get_frft_pk(sig,p)
    peakval = max(frft(sig,p))
end
%[text] Next iteration:
%[text] 1. Is current \> best? Y -\> current = best \
%[text]  
p_bounds = [0.5 2]; %[control:rangeslider:0a7a]{"position":[12,19]}

% One order lower than the difference in bounds.
p_step     = 10^(floor(log10(p_bounds(2)-p_bounds(1)))-1);

p_best     = 0;
p_current  = p_bounds(2);
p_previous = 0;
best_val   = 0;
frft_current = zeros(1,length(s));




max_steps = 200; %[control:editfield:37eb]{"position":[13,16]}
p_vals = zeros(1,max_steps);

for n = 1:max_steps %[output:group:6ce0d0f4]
    p_vals(n) = p_best;

    if p_current > p_bounds(1)
        frft_current = frft(s,p_current);
        curmax = max(abs(frft_current).^2);

        if curmax > best_val
            best_val = curmax;
            p_best = p_current;
        end
        p_current = p_current - p_step;

    else
        p_bounds(1) = p_best - p_step;
        p_bounds(2) = p_best + p_step;
        p_current = p_bounds(2);
        p_step = p_step*0.1;
    end

    
    % DEBUG
    % p_current_vals(n) = p_current;
    % momentum_vals(n)  = momentum;
    % p_best_vals(n)    = p_best;
    % p_step_vals(n)    = p_step;
     fprintf("%.0f> p_cur: %.8f | p_best: %.8f | best_val: %.4f | p_step: %.4f \n",n,p_current, p_best, best_val, p_step); %[output:1457ef57]
    % 

end %[output:group:6ce0d0f4]
%%
%[text] ## Comparing Comms Sig + Isolated
s_frft  = frft(s, p_best);
s1_frft = frft(s1,p_best);
s2_frft = frft(s2,p_best);


figure %[output:9748753e]
hold on %[output:9748753e]

subplot(3,1,1) %[output:9748753e]
plot((abs(s_frft).^2)); %[output:9748753e]
title("Combined Signal") %[output:9748753e]

subplot(3,1,2) %[output:9748753e]
plot((abs(s1_frft).^2)); %[output:9748753e]
title("Chirp") %[output:9748753e]

subplot(3,1,3) %[output:9748753e]
plot((abs(s2_frft).^2)); %[output:9748753e]
title("Comms Signal") %[output:9748753e]
%%
%[text] ## IFRFT Peak Suppression
s_frft_sqmag = abs(s_frft).^2;
s_frft_sqmag_sdev = std(s_frft_sqmag);

s_frft_cancelled = s2_frft - s_frft ;

figure %[output:877a34bc]
hold on %[output:877a34bc]

subplot(4,1,1) %[output:877a34bc]
plot(10*log10(abs(frft(s,p_best)).^2)); %[output:877a34bc]
title("Combined Signal") %[output:877a34bc]

subplot(4,1,2) %[output:877a34bc]
plot(10*log10(abs(frft(s1,p_best)).^2)); %[output:877a34bc]
title("Chirp") %[output:877a34bc]

subplot(4,1,3) %[output:877a34bc]
plot(10*log10(abs(frft(s2,p_best)).^2)); %[output:877a34bc]
title("Comms Signal") %[output:877a34bc]

subplot(4,1,4) %[output:877a34bc]
plot(10*log10(abs(s_frft_cancelled.^2))); %[output:877a34bc]
title("Error between combined and comms Signal") %[output:877a34bc]

s_cancelled = frft(s_frft_cancelled,-p_best);


figure %[output:1849c816]
hold on %[output:1849c816]
subplot(4,1,1) %[output:1849c816]
hold on %[output:1849c816]
plot(t,real(s1),DisplayName="Real") %[output:1849c816]
plot(t,imag(s1),DisplayName="Imaginary") %[output:1849c816]
title("Chirp") %[output:1849c816]

subplot(4,1,2) %[output:1849c816]
hold on %[output:1849c816]
plot(t,real(s2),DisplayName="Real") %[output:1849c816]
plot(t,imag(s2),DisplayName="Imaginary") %[output:1849c816]
title("Comms Signal") %[output:1849c816]

subplot(4,1,3) %[output:1849c816]
hold on %[output:1849c816]
plot(t,real(s),DisplayName="Real") %[output:1849c816]
plot(t,imag(s),DisplayName="Imaginary") %[output:1849c816]
title("Combined Signal") %[output:1849c816]

subplot(4,1,4) %[output:1849c816]
hold on %[output:1849c816]
plot(t,real(s_cancelled),DisplayName="Real") %[output:1849c816]
plot(t,imag(s_cancelled),DisplayName="Imaginary") %[output:1849c816]
title("Cancelled Signal") %[output:1849c816]
%%
%[text] ## Parameter Estimation
S = sqrt(T/fs) %[output:13470752]

est_phi = pi/2 * p_best;
est_f0 = s_frft %[output:1346566c]

%[text] ## References
%[text] \[1\] X. Chen, J. Guan, S. Yu, and Y. He, 'A novel adaptive filtering for LFM signal in FRFT domain', in IEEE 10th INTERNATIONAL CONFERENCE ON SIGNAL PROCESSING PROCEEDINGS, Oct. 2010, pp. 239–242. doi: 10.1109/ICOSP.2010.5655204.  
%[text]  

%[appendix]{"version":"1.0"}
%---
%[metadata:view]
%   data: {"layout":"inline","rightPanelPercent":30.1}
%---
%[control:rangeslider:0a7a]
%   data: {"defaultValue":"[0.5 1.5]","label":"p_bounds","max":2,"min":0,"run":"Section","runOn":"ValueChanging","step":0.1}
%---
%[control:editfield:37eb]
%   data: {"defaultValue":0,"label":"Edit field","run":"Section","valueType":"Double"}
%---
